  ],
  "events": [
    {
      "id": "event.snack",
      "category": "relationship",
      "trigger": "interact npc.serin \"간식 모임 시작\" 1.5",
      "staging": "reserved",
      "pause": "scene",
      "executionMode": "scene",
      "repeatPolicy": "once",
      "resources": [
        "npc.serin",
        "space.map.courtyard",
        "space.map.lounge",
        "input.player",
        "camera.main"
      ],
      "when": "eq story.intro_done true",
      "costMinutes": 10,
      "script": "wait notanumber / say npc.serin \"실습 노트를 같이 정리해 볼래?\" / choice \"서린과 무엇부터 할까?\" notes \"노트부터 정리하자\" tea \"차부터 준비하자\"",
      "forks": {
        "notes": "say npc.serin \"같이 하니까 마음이 놓여.\"",
        "tea": "say npc.serin \"좋아, 따뜻한 차가 필요했어.\""
      },
      "effects": "set memory.snack_done true / currency.add 20"
    },
    {
      "id": "event.snack_later",
      "category": "general",
      "trigger": "interact npc.serin \"나중에 간식 모임\" 1.5",
      "staging": "reserved",
      "pause": "scene",
      "executionMode": "scene",
      "repeatPolicy": "once",
      "resources": [
        "npc.serin",
        "space.map.courtyard",
        "space.map.lounge",
        "input.player",
        "camera.main"
      ],
      "when": "eq story.intro_done true",
      "costMinutes": 10,
      "script": "move npc.serin dest.snack / say npc.serin \"이번에는 차 한 잔만 가볍게 할까?\" / choice \"얼마나 할까?\" quick \"금방 끝내자\" long \"천천히 하자\"",
      "forks": {
        "quick": "say npc.serin \"좋아, 금방 끝내자.\"",
        "long": "say npc.serin \"좋아, 천천히 이야기하자.\""
      },
      "effects": "set memory.snack_later_done true / currency.add 5"
    }
  ]
