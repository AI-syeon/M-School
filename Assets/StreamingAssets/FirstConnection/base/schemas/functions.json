  "kinds": {
    "command": {
      "description": "이벤트 script·forks. 순서대로 실행",
      "nameRule": "registered",
      "functions": {
        "move": {
          "params": [
            {
              "name": "actor",
              "type": "id",
              "refKind": "npc"
            },
            {
              "name": "destination",
              "type": "id",
              "refKind": "destination"
            }
          ],
          "named": {
            "timeout": {
              "type": "number",
              "default": 30,
              "min": 0.001
            },
            "portals": {
              "type": "bool",
              "default": true
            },
            "async": {
              "type": "word"
            }
          },
          "negatable": false,
          "owner": "World/Movement",
          "writes": "actor",
          "description": "도착까지 대기. async=핸들이면 바로 다음으로"
        },
        "await": {
          "params": [
            {
              "name": "handles",
              "type": "word",
              "rest": true,
              "min": 1
            }
          ],
          "named": {},
          "negatable": false,
          "owner": "Scene/Control",
          "description": "핸들이 모두 끝날 때까지 대기. 하나라도 실패하면 나머지 취소 후 중단"
        },
        "say": {
          "params": [
            {
              "name": "speaker",
              "type": "id",
              "refKind": "npc"
            },
            {
              "name": "text",
              "type": "text"
            }
          ],
          "named": {},
          "negatable": false,
          "owner": "Scene/Control",
          "requiresClosedHandles": true,
          "writes": "dialogue"
        },
        "choice": {
          "params": [
            {
              "name": "prompt",
              "type": "text"
            },
            {
              "name": "options",
              "type": "word",
              "rest": true,
              "min": 1,
              "pairs": [
                {
                  "name": "fork",
                  "type": "word",
                  "fork": true
                },
                {
                  "name": "label",
                  "type": "text"
                }
              ]
            }
          ],
          "named": {},
          "negatable": false,
          "owner": "Scene/Control",
          "requiresClosedHandles": true,
          "writes": "dialogue",
          "description": "고른 가지를 실행한 뒤 다음 명령으로"
        },
        "branch": {
          "params": [
            {
              "name": "condition",
              "type": "text",
              "parse": "condition"
            },
            {
              "name": "then",
              "type": "word",
              "fork": true
            },
            {
              "name": "else",
              "type": "word",
              "optional": true,
              "fork": true
            }
          ],
          "named": {},
          "negatable": false,
          "owner": "Scene/Control",
          "requiresClosedHandles": true
        },
        "wait": {
          "params": [
            {
              "name": "seconds",
              "type": "number",
              "min": 0
            }
          ],
          "named": {},
          "negatable": false,
          "owner": "Clock/Schedule"
        },
        "camera": {
          "params": [
            {
              "name": "destination",
              "type": "id",
              "refKind": "destination"
            },
            {
              "name": "seconds",
              "type": "number",
              "min": 0
            }
          ],
          "named": {
            "async": {
              "type": "word"
            }
          },
          "negatable": false,
          "owner": "Scene/Control",
          "writes": "camera"
        },
        "animate": {
          "params": [
            {
              "name": "actor",
              "type": "id",
              "refKind": "npc"
            },
            {
              "name": "clip",
              "type": "word"
            },
            {
              "name": "seconds",
              "type": "number",
              "min": 0
            }
          ],
          "named": {
            "async": {
              "type": "word"
            }
          },
          "negatable": false,
          "owner": "Scene/Control",
          "writes": "actor"
        },
        "perform": {
          "params": [
            {
              "name": "domain",
              "type": "enum:class|encounter|puzzle|craft|relationship|project|activity"
            },
            {
              "name": "definition",
              "type": "idOrLabel",
              "refKindFrom": {
                "param": "domain",
                "map": {
                  "class": "class",
                  "encounter": "encounter",
                  "puzzle": "puzzleTarget",
                  "craft": "recipe",
                  "relationship": "relationship",
                  "project": "project",
                  "activity": "activity"
                }
              }
            }
          ],
          "named": {
            "mode": {
              "type": "enum:normal|practice",
              "default": "normal"
            }
          },
          "negatable": false,
          "owner": "도메인 서비스",
          "requiresClosedHandles": true,
          "description": "도메인 작업 성공까지 대기. 결과는 effects 커밋이 읽는다"
        }
      }
    },
